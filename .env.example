# Copy to .env and fill in. Never commit .env.

# Which model provider to use: groq (free key), ollama (local, no key) or anthropic (paid).
RP_PROVIDER=groq
GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# Web search (free key, no card): https://app.tavily.com
TAVILY_API_KEY=

# Optional overrides. RP_MODEL defaults per provider:
#   groq -> openai/gpt-oss-120b, ollama -> qwen2.5:7b, anthropic -> claude-opus-5-5
# RP_MODEL=
# RP_BASE_URL=          # e.g. another OpenAI-compatible endpoint
# RP_EFFORT=medium      # anthropic only
# RP_MAX_STEPS=8
